# Copy to server/.env and fill in. NEVER commit the real file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_project_hub
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50
# Used only by `npm run create-admin` (one-time admin initialisation)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
